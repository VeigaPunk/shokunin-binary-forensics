    display: flex;
    flex-wrap: wrap;
    position: relative;
  }

  .workspace-control {
    margin: 2px 2px;
    border-width: 0px;
    border-radius: 1em;
    background-color: var(--foreground);
  }

  button.workspace-control {
    width: 2.5em;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  button.workspace-control.workspace-service,
