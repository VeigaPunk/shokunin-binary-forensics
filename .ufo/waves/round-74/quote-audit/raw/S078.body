    margin-left: 0.5em;
    font-size: 0.7em;
    opacity: 0.6;
  }

  .workspace-service.active,
  .workspace-description-control.active {
    color: #fff;
    background-color: var(--foreground) !important;
    box-shadow: inset 0 0 0 1px var(--highlight) !important;
  }

  .workspace-service.active:focus,
  .workspace-description-control.active:focus {
    box-shadow: inset 0 0 0 1px var(--highlight), 0 0 0 0.2rem rgba(108, 117, 125, 0.5) !important;
  }

  .workspace-input input {
    height: 100% !important;
    box-sizing: border-box;
    padding-left: 0.5em;
    padding-right: 1em;
    color: #fff;
    background-color: var(--foreground);
    border: 0;
    border-color: #000 !important;
    border-radius: 1em;
    box-shadow: none !important;
  }

  .workspace-input input::placeholder {
    color: var(--highlight);
    opacity: 1;
  }

  .workspace-input input.disabled {
    color: var(--highlight);
  }

  .workspace-input input:focus,
  .workspace-input input:hover {
    outline: 0 !important;
  }

  .workspace-highlight {
    color: var(--highlight);
  }

  .workspace-input {
    padding-left: 1em;
  }

  .workspace-control-spacer {
    flex: 1;
  }

