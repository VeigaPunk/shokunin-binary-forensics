    border-radius: 0.25em;
    background-color: transparent;
    cursor: pointer;
  }

  label#workspace-change-privilege input:focus-visible {
    outline: 0;
    box-shadow: 0 0 0 0.2rem rgba(108, 117, 125, 0.5);
  }

