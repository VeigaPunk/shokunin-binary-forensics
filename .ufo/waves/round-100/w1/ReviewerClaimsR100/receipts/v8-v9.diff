> def v9_derivation_span(text):
>     """(start, end) of the entry's derivation section: its heading and preamble, up to the next `## ` heading."""
>     m = V9_DECL_RE.search(text)
>     if not m:
>         return None
>     e = text.find("\n## ", m.end())
>     return m.start(), (e if e >= 0 else len(text))
