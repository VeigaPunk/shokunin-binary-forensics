<style id="wp-custom-css">
/* .postid-4970.single.single-publication .elementor-toc__body > ul li ul {
    display: block !important;
	    margin-left: 25px;
} */
.single.single-publication .content-area .list-alpha.list_num ol {
    list-style-type: auto;
}
.single.single-publication .content-area .list-alpha ol > li > ol{
	list-style-type: lower-alpha !important;
}
.single.single-publication .content-area .list-alpha.list_num ol > li > ol > li > ol {
    list-style-type: upper-roman !important;
}

.appendix_table td{
	white-space:normal !important;
}
.format_analysis table tr th {
    width: 33.33%;
}
#site-footer,.page-header,#site-header{display:none !important;}
.elementor-10 .elementor-element.elementor-element-21299a8 .wpcap-grid-container .wpcap-post .post-grid-meta span + span:before{display:none !important;}
.post-date{background:url( https://swgde.org/wp-content/uploads/2023/08/Calander.png) left center no-repeat !important; padding-left: 22px; margin-left: 15px;}
.post-author{background:url(https://swgde.org/wp-content/uploads/2023/08/User.png) left center no-repeat !important; padding-left: 22px;}
.comments-area a, .page-content a {
    text-decoration: none;
}
.post-grid-thumbnail img.attachment-full.size-full.wp-post-image:hover {
    transform: scale(1.1);
    transition: transform .7s ease;
}
a.read-more-btn:hover {
    transform: scale(1.1);
    transition: transform .7s ease;
}
.post-grid-text-wrap {
    padding: 5px 25px;
}
input#search-docs {
    border-radius: 5px;
    border: 1px solid #e3e3e3;
    padding: 13px 15px 13px 45px;
	    background-color: #f9f9f9;
}

#search-docs-in-page::before {
    content: "\f1c1";
    position: absolute;
    left: 22px;
    z-index: 1;
    top: calc(50%);
    font-family: "Font Awesome 5 Free";
    font-weight: 900;
    -webkit-font-smoothing: antialiased;
    display: inline-block;
    font-style: normal;
    font-variant: normal;
    text-rendering: auto;
    line-height: 1;
    transform: translateY(-50%);
    color: #949494;
    font-size: 18px;
    line-height: normal;
}
#search-docs-in-page {
    position: relative;
}
#search-docs-in-page button {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
