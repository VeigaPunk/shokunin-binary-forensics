<!-- Google Tag Manager (noscript) -->
				<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PDL4WLB3" height="0" width="0" style="display:none;visibility:hidden" aria-hidden="true"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->			<script>
				const registerAllyAction = () => {
					if ( ! window?.ElementorProFrontendConfig || ! window?.elementorFrontend?.utils?.urlActions ) {
						return;
					}

					elementorFrontend.utils.urlActions.addAction( 'allyWidget:open', () => {
						if (window?.ea11yWidget?.widget?.open) {
							return window.ea11yWidget.widget.isOpen()
								? window.ea11yWidget.widget.close()
								: window.ea11yWidget.widget.open();
						}
					} );
				};

				const waitingLimit = 30;
				let retryCounter = 0;

				const waitForElementorPro = () => {
					return new Promise( ( resolve ) => {
						const intervalId = setInterval( () => {
							if ( retryCounter === waitingLimit ) {
								resolve( null );
							}

							retryCounter++;

							if ( window.elementorFrontend && window?.elementorFrontend?.utils?.urlActions ) {
								clearInterval( intervalId );
								resolve( window.elementorFrontend );
							}
								}, 100 ); // Check every 100 milliseconds for availability of elementorFrontend
					});
				};

				waitForElementorPro().then( () => { registerAllyAction(); });
			</script>
						<script>
				( () => {
					const lazyloadRunObserver = () => {
						const lazyloadBackgrounds = document.querySelectorAll( `.e-con.e-parent:not(.e-lazyloaded)` );
						const lazyloadBackgroundObserver = new IntersectionObserver( ( entries ) => {
							entries.forEach( ( entry ) => {
								if ( entry.isIntersecting ) {
									let lazyloadBackground = entry.target;
									if( lazyloadBackground ) {
										lazyloadBackground.classList.add( 'e-lazyloaded' );
									}
									lazyloadBackgroundObserver.unobserve( entry.target );
								}
							});
						}, { rootMargin: '200px 0px 200px 0px' } );
						lazyloadBackgrounds.forEach( ( lazyloadBackground ) => {
							lazyloadBackgroundObserver.observe( lazyloadBackground );
						} );
					};
					const events = [
						'DOMContentLoaded',
						'elementor/lazyload/observe',
					];
					events.forEach( ( event ) => {
						document.addEventListener( event, lazyloadRunObserver );
					} );
				} )();
			</script>
			<script>document.addEventListener('DOMContentLoaded', function() {
  // Fix Who We Are nav links
  document.querySelectorAll('a[href*="who-we-are"]').forEach(function(link) {
    link.setAttribute('aria-label', 'Who We Are');
  });
  
  // Fix Imaging Committee image links
  document.querySelectorAll('a[href*="published-by-committee/imaging"]').forEach(function(link) {
    link.setAttribute('aria-label', 'Imaging Committee');
  });

  // Fix Audio Committee image links
  document.querySelectorAll('a[href*="published-by-committee/audio"]').forEach(function(link) {
    link.setAttribute('aria-label', 'Audio Committee');
  });
});
// Fix Published By Committee links
  document.querySelectorAll('a[href*="documents/published-by-committee/"]').forEach(function(link) {
    if (!link.getAttribute('aria-label')) {
      link.setAttribute('aria-label', 'Published By Committee');
    }
  });
// Fix Home/Logo links
  document.querySelectorAll('a[href="https://www.swgde.org/"]').forEach(function(link) {
    if (!link.getAttribute('aria-label')) {
      link.setAttribute('aria-label', 'Home');
    }
  });

  // Fix Membership links
  document.querySelectorAll('a[href*="swgde.org/membership/"]').forEach(function(link) {
    if (!link.getAttribute('aria-label')) {
      link.setAttribute('aria-label', 'Membership');
    }
  });
// Fix Drafts Released For Comment links
  document.querySelectorAll('a[href*="draft-released-for-comment"]').forEach(function(link) {
    if (!link.getAttribute('aria-label')) {
      link.setAttribute('aria-label', 'Drafts Released For Comment');
    }
  });

  // Fix Video Committee links
  document.querySelectorAll('a[href*="published-by-committee/video"]').forEach(function(link) {
    if (!link.getAttribute('aria-label')) {
      link.setAttribute('aria-label', 'Video Committee');
    }
  });

  // Fix Documents nav links
  document.querySelectorAll('a[href*="swgde.org/documents/"]').forEach(function(link) {
    if (!link.getAttribute('aria-label')) {
      link.setAttribute('aria-label', 'Documents');
    }
  });
// Fix Forensics Committee links
  document.querySelectorAll('a[href*="published-by-committee/forensics"]').forEach(function(link) {
    if (!link.getAttribute('aria-label')) {
      link.setAttribute('aria-label', 'Forensics Committee');
    }
  });

  // Fix Published Complete Listing links
  document.querySelectorAll('a[href*="current-documents"]').forEach(function(link) {
    if (!link.getAttribute('aria-label')) {
      link.setAttribute('aria-label', 'Published Complete Listing');
    }
  });

  // Fix Quality & Standards Committee links
  document.querySelectorAll('a[href*="quality-standards"]').forEach(function(link) {
    if (!link.getAttribute('aria-label')) {
      link.setAttribute('aria-label', 'Quality and Standards Committee');
    }
  });

  // Fix Photography Committee links
  document.querySelectorAll('a[href*="published-by-committee/photography"]').forEach(function(link) {
    if (!link.getAttribute('aria-label')) {
      link.setAttribute('aria-label', 'Photography Committee');
    }
  });</script><link rel='stylesheet' id='widget-image-css' href='https://www.swgde.org/wp-content/plugins/elementor/assets/css/widget-image.min.css?ver=4.2.2' media='all' />
