<script data-wp-strategy="defer" defer id="pdfp-pdfposter-view-script-js" src="https://www.swgde.org/wp-content/plugins/pdf-poster/build/blocks/pdf-poster/view.js?ver=edfd09d4d3dd6154ac9a"></script>
<script>
(function () {
  function init() {
    const blocks = document.querySelectorAll('.swgde-pdf');
    if (!blocks.length) return;

    if (!window.pdfjsLib) {
      console.error('pdfjsLib not found. pdf.min.js did not load.');
      return;
    }

    // Set worker path
    window.pdfjsLib.GlobalWorkerOptions.workerSrc =
      'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.6.82/pdf.worker.min.js';

    blocks.forEach(function (container) {
      const pdfUrl = container.getAttribute('data-pdf');
      const canvas = container.querySelector('canvas');
      if (!pdfUrl || !canvas) return;

      const ctx = canvas.getContext('2d');

      // Render page 1
      window.pdfjsLib.getDocument({ url: pdfUrl }).promise
        .then(function (pdf) { return pdf.getPage(1); })
        .then(function (page) {
          const viewport = page.getViewport({ scale: 1 });
          const cw = container.clientWidth || 800;
          const scale = cw / viewport.width;
          const vp = page.getViewport({ scale: scale });

          canvas.width = Math.floor(vp.width);
          canvas.height = Math.floor(vp.height);

          return page.render({ canvasContext: ctx, viewport: vp }).promise;
        })
        .catch(function (err) {
          console.error('PDF render error:', err);
          container.insertAdjacentHTML(
            'beforeend',
            '<p style="margin:10px 0;color:#b00020;">PDF failed to load. Use the Open PDF link above.</p>'
          );
        });
    });
  }

  // Run after DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  // Elementor sometimes loads content dynamically
  document.addEventListener('elementor/frontend/init', init);
})();
</script>


