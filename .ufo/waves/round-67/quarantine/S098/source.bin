  {
    "sha": "36cae9016117f49a2cd0823137456ae804ef7035",
    "node_id": "C_kwDOSB6hVdoAKDM2Y2FlOTAxNjExN2Y0OWEyY2QwODIzMTM3NDU2YWU4MDRlZjcwMzU",
    "commit": {
      "author": {
        "name": "Cassie_Fox",
        "email": "249835913+CassieFox23@users.noreply.github.com",
        "date": "2026-10-23T21:51:22Z"
      },
      "committer": {
        "name": "GitHub",
        "email": "noreply@github.com",
        "date": "2026-10-23T21:51:22Z"
      },
      "message": "docs(readme): show a dark showcase image on dark themes (#6915)\n\nThe showcase illustration was a single light PNG, so it stayed a white\nslab on GitHub's dark themes. Redraw it as a light and a dark SVG, and\nswap the linked image in README.md and all 21 translations for a\n<picture> with a prefers-color-scheme: dark source. Alt text and link\ntargets are unchanged. The PNG is deleted because nothing else uses it.\nwebsite/figures.md notes the pair.\n\n🤖 Generated with Claude Code (Sonnet 5.5) 🦊\n\nCo-authored-by: Claude Sonnet 5.5 <noreply@anthropic.com>",
      "tree": {
        "sha": "1912d1cbcea2306ea2c3bb69f00dd86be42a1624",
        "url": "https://api.github.com/repos/morluto/rea/git/trees/1912d1cbcea2306ea2c3bb69f00dd86be42a1624"
      },
      "url": "https://api.github.com/repos/morluto/rea/git/commits/36cae9016117f49a2cd0823137456ae804ef7035",
      "comment_count": 0,
      "verification": {
        "verified": true,
        "reason": "valid",
