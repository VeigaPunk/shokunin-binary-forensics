<td id="S2.SS1.p5.1.23.1" class="ltx_td ltx_align_left ltx_align_top">
<span id="S2.SS1.p5.1.23.1.1" class="ltx_inline-block ltx_align_top" style="width:85.4pt;">
<span id="S2.SS1.p5.1.23.1.1.1" class="ltx_p">Data Size</span>
