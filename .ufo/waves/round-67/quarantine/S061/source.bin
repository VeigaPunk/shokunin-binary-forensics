<script src="/plugin/chao_editor/js/purify.min.js"></script>
<script src="/plugin/chao_editor/js/marked.js"></script>
<script src="/plugin/chao_editor/js/marked-katex-extension.umd.js"></script>
<script src="/plugin/chao_editor/js/marked-toc-extension.js"></script>

<script>

	function escapeIllegalTags(html, allowedTags) {
		const allowedTagSet = new Set(
			(allowedTags || []).map(function (tagName) {
				return String(tagName).toLowerCase();
			})
		);

		/*
		* 把一段非法 HTML 标记转换成可见文本。
		* 必须先处理 &，避免原有实体在后续 HTML 解析时被解码。
		*/
		function escapeMarkup(value) {
			return value
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;');
		}

		/*
		* 判断当前位置的字符是否被奇数个反斜杠转义。
		* 例如：
		* \<iframe>  已由 Markdown 转义，不作为原生 HTML 处理。
		* \\<iframe> 前面的 < 没有被转义，需要继续处理。
		*/
		function isBackslashEscaped(text, index) {
			let count = 0;

			for (let i = index - 1; i >= 0 && text[i] === '\\'; i--) {
				count++;
			}

			return count % 2 === 1;
		}

		/*
		* 读取一整行。
		* contentEnd 不包含换行符和 CR；
		* lineEnd 指向下一行开头。
		*/
		function readLine(text, start) {
			const newlineIndex = text.indexOf('\n', start);

			if (newlineIndex === -1) {
				let contentEnd = text.length;

				if (contentEnd > start && text[contentEnd - 1] === '\r') {
					contentEnd--;
				}

				return {
					contentEnd: contentEnd,
					lineEnd: text.length
				};
			}

			return {
				contentEnd:
					newlineIndex > start && text[newlineIndex - 1] === '\r'
						? newlineIndex - 1
						: newlineIndex,
				lineEnd: newlineIndex + 1
			};
		}

		/*
		* 检测当前位置是否为 Markdown 围栏代码块开头。
		* 支持：
		* ```
		* ```javascript
		* ~~~
		* 最长允许 3 个前导空格。
		*/
		function readFencedCodeBlock(text, start) {
			const firstLine = readLine(text, start);
			const lineText = text.slice(start, firstLine.contentEnd);
			const openingMatch = lineText.match(
				/^ {0,3}(`{3,}|~{3,})(.*)$/
			);

			if (!openingMatch) {
				return null;
			}

			const openingFence = openingMatch[1];
			const fenceCharacter = openingFence[0];
			const fenceLength = openingFence.length;
			const infoString = openingMatch[2];

			/*
			* CommonMark 规定反引号围栏的信息字符串中
			* 不能包含反引号。
			*/
			if (
				fenceCharacter === '`' &&
				infoString.indexOf('`') !== -1
			) {
				return null;
			}

			let cursor = firstLine.lineEnd;

			while (cursor < text.length) {
				const currentLine = readLine(text, cursor);
				const currentLineText = text.slice(
					cursor,
					currentLine.contentEnd
				);

				const closingMatch = currentLineText.match(
					/^ {0,3}(`{3,}|~{3,})[ \t]*$/
				);

				if (
					closingMatch &&
					closingMatch[1][0] === fenceCharacter &&
					closingMatch[1].length >= fenceLength
				) {
					return {
						end: currentLine.lineEnd
					};
				}

				cursor = currentLine.lineEnd;
			}

			/*
			* 没有闭合围栏时，CommonMark 会把剩余内容
			* 全部视为代码块。
			*/
			return {
				end: text.length
			};
		}

		/*
		* 查找与当前位置反引号数量完全相同的结束分隔符。
		*
		* `code`
		* ``code containing ` character``
		*/
		function findInlineCodeEnd(text, start) {
			let openingEnd = start;

			while (
				openingEnd < text.length &&
				text[openingEnd] === '`'
			) {
				openingEnd++;
			}

			const openingLength = openingEnd - start;
			let cursor = openingEnd;

			while (cursor < text.length) {
				const candidate = text.indexOf('`', cursor);

				if (candidate === -1) {
					return null;
				}

				let candidateEnd = candidate;

				while (
					candidateEnd < text.length &&
					text[candidateEnd] === '`'
				) {
					candidateEnd++;
				}

				if (candidateEnd - candidate === openingLength) {
					return {
						end: candidateEnd
					};
				}

				cursor = candidateEnd;
			}

			return null;
		}

		/*
		* 找到 HTML 标记真正的结束位置。
		*
		* 属性引号中的 > 不视为标签结束：
		* <div title="1 > 0">
		*
		* 同时记录引号外是否出现嵌套的 <，
		* 这通常表示标记格式异常。
		*/
		function findNormalTagEnd(text, start) {
			let quote = null;
			let hasNestedOpeningBracket = false;

			for (let i = start + 1; i < text.length; i++) {
				const character = text[i];

				if (quote !== null) {
					if (character === quote) {
						quote = null;
					}

					continue;
				}

				if (character === '"' || character === "'") {
					quote = character;
					continue;
				}

				if (character === '<') {
					hasNestedOpeningBracket = true;
					continue;
				}

				if (character === '>') {
					return {
						end: i + 1,
						malformed: hasNestedOpeningBracket
					};
				}
			}

			return null;
		}

		/*
		* 读取注释、CDATA、处理指令或普通标签。
		*/
		function readHtmlConstruct(text, start) {
			let terminator = null;

			if (text.slice(start, start + 4) === '<!--') {
				terminator = '-->';
			} else if (
				text.slice(start, start + 9).toUpperCase() ===
				'<![CDATA['
			) {
				terminator = ']]>';
			} else if (text.slice(start, start + 2) === '<?') {
				terminator = '?>';
			}

			if (terminator !== null) {
				const terminatorIndex = text.indexOf(
					terminator,
					start + 2
				);

				return {
					end:
						terminatorIndex === -1
							? text.length
							: terminatorIndex + terminator.length,
					special: true,
					malformed: terminatorIndex === -1
				};
			}

			const normalTag = findNormalTagEnd(text, start);

			if (!normalTag) {
				return null;
			}

			return {
				end: normalTag.end,
				special: text.slice(start, start + 2) === '<!',
				malformed: normalTag.malformed
			};
		}

		/*
		* CommonMark 自动链接不是 HTML 标签，应交给 marked 处理：
		*
		* <https://example.com>
		* <mailto:user@example.com>
		* <user@example.com>
		*/
		function isMarkdownAutolink(raw) {
			const uriAutolink =
				/^<[A-Za-z][A-Za-z0-9+.-]{1,31}:[^\s<>]*>$/;

			const emailAutolink =
				/^<[A-Za-z0-9.!#$%&'*+/=?^_`{|}~-]+@[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+>$/;

			return uriAutolink.test(raw) || emailAutolink.test(raw);
		}

		/*
		* 提取合法的开始标签或结束标签名称。
		*
		* 开始标签：
		* <div>
		* <div class="x">
		* <br />
		*
		* 结束标签必须只有标签名：
		* </div>
		*/
		function getTagName(raw) {
			const closingMatch = raw.match(
				/^<\s*\/\s*([A-Za-z][A-Za-z0-9:-]*)\s*>$/
			);

			if (closingMatch) {
				return closingMatch[1].toLowerCase();
			}

			const openingMatch = raw.match(
				/^<\s*([A-Za-z][A-Za-z0-9:-]*)(?=[\s/>])/
			);

			if (openingMatch) {
				return openingMatch[1].toLowerCase();
			}

			return null;
		}

		let output = '';
		let index = 0;

		while (index < html.length) {
			const character = html[index];
			const isLineStart =
				index === 0 || html[index - 1] === '\n';

			/*
			* Markdown 围栏代码块原样保留，
			* 由 marked 负责转义为 <pre><code>。
			*/
			if (isLineStart) {
				const fencedCode = readFencedCodeBlock(html, index);

				if (fencedCode) {
					output += html.slice(index, fencedCode.end);
					index = fencedCode.end;
					continue;
				}

				/*
				* Markdown 缩进代码块。
				* 每个以 Tab 或至少 4 个空格开头的行均原样保留。
				*/
				const currentLine = readLine(html, index);
				const currentLineText = html.slice(
					index,
					currentLine.contentEnd
				);

				if (/^(?: {4}|\t)/.test(currentLineText)) {
					output += html.slice(index, currentLine.lineEnd);
					index = currentLine.lineEnd;
					continue;
				}
			}

			/*
			* Markdown 行内代码原样保留。
			*/
			if (character === '`') {
				const inlineCode = findInlineCodeEnd(html, index);

				if (inlineCode) {
					output += html.slice(index, inlineCode.end);
					index = inlineCode.end;
					continue;
				}

				output += character;
				index++;
				continue;
			}

			if (
				character !== '<' ||
				isBackslashEscaped(html, index)
			) {
				output += character;
				index++;
				continue;
			}

			const construct = readHtmlConstruct(html, index);

			/*
			* 没有找到结束位置，至少转义当前的 <，
			* 避免形成未闭合的原生 HTML。
			*/
			if (!construct) {
				output += '&lt;';
				index++;
				continue;
			}

			const raw = html.slice(index, construct.end);

			/*
			* Markdown 自动链接交给 marked。
			* 其 href 最终仍须经过 DOMPurify。
			*/
			if (
				!construct.special &&
				!construct.malformed &&
				isMarkdownAutolink(raw)
			) {
				output += raw;
				index = construct.end;
				continue;
			}

			/*
			* 注释、DOCTYPE、CDATA、处理指令以及结构异常的标签
			* 都不属于允许的普通 HTML 标签。
			*/
			if (construct.special || construct.malformed) {
				output += escapeMarkup(raw);
				index = construct.end;
				continue;
			}

			const tagName = getTagName(raw);

			if (tagName && allowedTagSet.has(tagName)) {
				output += raw;
			} else {
				output += escapeMarkup(raw);
			}

			index = construct.end;
		}

		return output;
	}
	let mermaidLoadPromise = null;
	function loadMermaid() {
		if (window.mermaid) {
			return Promise.resolve(window.mermaid);
		}

		if (mermaidLoadPromise) {
			return mermaidLoadPromise;
		}

		mermaidLoadPromise = new Promise(function (resolve, reject) {
			const script = document.createElement('script');

			script.src = '/plugin/chao_editor/js/mermaid.min.js';
			script.async = true;

			script.onload = function () {
				if (!window.mermaid) {
					reject(new Error('Mermaid 加载完成但未找到全局对象'));
					return;
				}

				window.mermaid.initialize({
					startOnLoad: false,
					securityLevel: 'sandbox',
					theme: 'default',
					maxTextSize: 20000,
					maxEdges: 200,
					flowchart: {
						useMaxWidth: true,
						htmlLabels: true
					}
				});

				resolve(window.mermaid);
			};

			script.onerror = function () {
				// 允许下次重新尝试
				mermaidLoadPromise = null;
				reject(new Error('Mermaid 文件加载失败'));
			};

			document.head.appendChild(script);
		});

		return mermaidLoadPromise;
	}
	async function renderCodeBlocks(callback = function () {}) {
		const previews = document.querySelectorAll(
			'.message.message_md_type'
		);

		if (!previews.length) {
			callback();
			return;
		}

		const mermaidNodes = [];

		previews.forEach(function (preview) {
			/*
			* 普通代码立即高亮。
			* 明确排除 Mermaid，避免 highlight.js 处理图表源码。
			*/
			preview
				.querySelectorAll(
					'pre > code:not(.language-mermaid):not([data-highlighted])'
				)
				.forEach(function (codeElement) {
					hljs.highlightElement(codeElement);
				});

			/*
			* Mermaid 单独收集。
			*/
			preview
				.querySelectorAll('pre > code.language-mermaid')
				.forEach(function (codeElement) {
					const preElement = codeElement.parentElement;
					const mermaidSource = codeElement.textContent || '';

					preElement.classList.add('mermaid');
					preElement.setAttribute(
						'data-mermaid-pending',
						'true'
					);

					// 移除 code 包装，保留纯文本图表源码
					preElement.textContent = mermaidSource;

					mermaidNodes.push(preElement);
				});
		});

		/*
		* 页面只有普通代码，没有 Mermaid：
		* 普通代码此时已经高亮，且不会加载 mermaid.min.js。
		*/
		if (!mermaidNodes.length) {
			callback();
			return;
		}

		/*
		* 页面包含 Mermaid：
		* 普通代码已经完成高亮，现在才异步加载 Mermaid。
		*/
		try {
			const mermaidApi = await loadMermaid();

			await mermaidApi.run({
				nodes: mermaidNodes,
				suppressErrors: true
			});

			mermaidNodes.forEach(function (node) {
				node.removeAttribute('data-mermaid-pending');
			});

			callback();
		} catch (error) {
			console.error('Mermaid 加载或渲染失败：', error);

			// 加载失败时显示原始 Mermaid 源码
			mermaidNodes.forEach(function (node) {
				node.removeAttribute('data-mermaid-pending');
			});
		}
	}
	function decodeEncryptedMarks(source) {
		return source.replace(
			/<mark\s+class\s*=\s*["']encrypted["']\s*>([\s\S]*?)<\/mark>/gi,
			(matched, encryptedText) => {
			try {
				return xn.urldecode(kx_url_decrypt(encryptedText));
			} catch (error) {
				console.error("解码失败：", error);
				return matched; // 解码失败时保留原内容
			}
			}
		);
	}

	const options = {
		throwOnError: false
	};
	marked.use(markedKatex(options));
	marked.use({ extensions: [tocList]});
	marked.use({
		gfm: true, //一个布尔值,允许 Git Hub标准
		breaks: true, //允许回车换行。该选项要求 gfm 为true
		pedantic: false, //尽可能地兼容 markdown.pl的晦涩部分。不纠正原始模型任何的不良行为和错误
	});
	const renderer = new marked.Renderer()
	renderer.html = function ({ text }) {
		const template = document.createElement('template')
		template.innerHTML = text

		template.content.querySelectorAll('*').forEach(el => {
			el.removeAttribute('class')
			el.removeAttribute('style')
		})

		return template.innerHTML
	}
	marked.use({ renderer })
	// const ALLOWED_TAGS = ['h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'p', 'hr', 'pre', 'blockquote','ol', 'ul', 'li', 'dl', 'dt', 'dd','img','table', 'thead', 'tbody', 'tfoot', 'tr', 'th', 'td', 'caption', 'col', 'colgroup','div', 'span','code','a', 'em', 'strong', 'small', 's', 'mark','sub','sup','br', 'b','i', 'del'];
	// const ALLOWED_ATTR = ['href','title','target','rel','src','alt','width','height','border','cellpadding','cellspacing','colspan','rowspan','scope','align','span','d','fill','fill-rule','stroke','stroke-width','viewBox', 'preserveAspectRatio'];

	document.querySelectorAll('.message.message_md_type .js-message-markdown').forEach(function (textarea) {
		// const safeInput = escapeIllegalTags(decodeEncryptedMarks(textarea.value) || '',ALLOWED_TAGS);
		const safeInput = decodeEncryptedMarks(textarea.value) || '';
		// console.log(safeInput);
		const markdownHtml = marked.parse(safeInput);
		const cleanHtml = DOMPurify.sanitize(markdownHtml, {
			// ALLOWED_TAGS: ALLOWED_TAGS,
			// ALLOWED_ATTR: ALLOWED_ATTR,
			FORBID_TAGS: ['script', 'iframe', 'object', 'embed', 'form', 'button', 'title', 'textarea', 'style', 'xmp', 'noembed', 'noframes', 'plaintext', 'template', 'applet' , 'textarea', 'input', 'select', 'meta', 'link', 'base', 'canvas', 'svg', 'math'],
    		FORBID_ATTR: ['srcdoc', 'onerror', 'onload', 'onclick', 'onmouseover'],
		});
				
		// 移除textarea下方的js-message-html元素，指定class为js-message-html
		if (textarea.nextElementSibling && textarea.nextElementSibling.classList.contains('js-message-html')) {
			textarea.nextElementSibling.remove();
		}
		textarea.insertAdjacentHTML('afterend', cleanHtml); // 插入清理后的HTML
		textarea.remove();
	});
	renderCodeBlocks( function () {
		console.log('Mermaid 加载完成');
	});
</script>

	
